module tb_mux21();
 reg S, A, B;
 wire F;
 reg [3:0] ctr;
 mux21 uut(S, A, B, F);
 // The initial block runs procedural code before anything else runs.
 initial begin
 $display("Testbench start");
 $display("S A B | F");
{S, A, B, ctr} = 7'b0000000;
 end
